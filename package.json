{
  "name": "letterdrop-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server for Letterdrop competitor monitoring",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "letterdrop",
    "competitor-monitoring"
  ],
  "author": "Letterdrop",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.18.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "prettier": "^3.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@hono/node-server": "^1.19.10",
    "express-rate-limit": "^8.2.2",
    "fast-uri": "^3.1.5",
    "form-data": "^4.0.6",
    "hono": "^4.12.25",
    "ip-address": "^10.3.1",
    "path-to-regexp@<1.0.0": "^0.1.13",
    "path-to-regexp@>=8.0.0": "^8.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
