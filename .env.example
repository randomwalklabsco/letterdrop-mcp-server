# letterdrop-mcp-server configuration

# Letterbox API Configuration
LETTERBOX_API_URL=https://api.letterdrop.com
FRONTEND_URL=https://app.letterdrop.com

# MCP Server Configuration
MCP_SERVER_PORT=3002
# Optional: comma-separated additional browser origins for CORS
# Example: MCP_CORS_ORIGINS=https://mcp-inspector.example.com,http://localhost:5173
MCP_CORS_ORIGINS=

# Public origin published in OAuth metadata (set in deployed environments)
MCP_PUBLIC_URL=

# Development only: API key used when no Authorization header is sent
LETTERBOX_API_KEY=

# Environment
NODE_ENV=development
